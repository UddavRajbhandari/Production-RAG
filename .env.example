# Production RAG API Configuration

# ===========================================
# API Settings
# ===========================================
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False
# For local frontend dev, DO NOT set NEXT_PUBLIC_API_URL. Instead the
# Next.js rewrite rule in next.config.js proxies /api/v1/ to the backend
# (same origin, cookies work automatically). Default proxy target is
# localhost:7860; override with env var: API_PROXY_TARGET=http://localhost:8000
#
# For Vercel production: set API_PROXY_TARGET to your HF Space URL so the
# Next.js API routes (/api/ingest/file, /api/query) can reach the backend:
#   API_PROXY_TARGET=https://udhov-production-rag-backend.hf.space
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://production-rag.vercel.app

# ===========================================
# Authentication & Session
# ===========================================
# SESSION_SECRET: HMAC key for signing session cookies.
# CRITICAL: Set this to a fixed value in production AND locally.
#   If it changes, ALL existing session cookies become invalid and users
#   will need their saved tenant_id to restore their data.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# SESSION_SECRET=replace_with_your_secret_hex_string

API_KEY=your_api_key_here
REQUIRE_API_KEY=True

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_PER_MINUTE=60

# ===========================================
# LLM Configuration
# ===========================================
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
HF_TOKEN=your_huggingface_token_here

# ===========================================
# QDRANT CLOUD (Production)
# ===========================================
# Uncomment these for Qdrant Cloud (with native BM25 support)
# pragma: allowlist secret
# QDRANT_URL=https://your-cluster.qdrant.cloud
# QDRANT_API_KEY=your_qdrant_api_key_here

# ===========================================
# NEON POSTGRES (Production)
# ===========================================
# Uncomment for Neon Postgres cloud database
# DATABASE_URL=postgres://user:pass@ep-xxx.us-east-1.aws.neon.tech/rag?sslmode=require  # pragma: allowlist secret

# ===========================================
# LOCAL DEVELOPMENT (Default when cloud vars commented)
# ===========================================
# Qdrant Docker (when QDRANT_URL not set)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=production_rag_v1

# ===========================================
# Observability
# ===========================================
SENTRY_DSN=your_sentry_dsn_here

# ===========================================
# Deployment
# ===========================================
RENDER_DEPLOY_HOOK=your_render_deploy_hook_here

# ===========================================
# STORAGE MODE DETECTION
# ===========================================
# Cloud mode: Set QDRANT_URL + DATABASE_URL (Qdrant Cloud + Neon)
# Local mode: Leave above vars commented (uses Docker + SQLite)
#
# The system auto-detects based on these env vars:
# - QDRANT_URL set → Qdrant Cloud (with native BM25)
# - DATABASE_URL set → Neon Postgres
# - Both set → Full cloud mode
# - Neither set → Local development mode
