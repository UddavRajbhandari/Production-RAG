# Production RAG API Configuration

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# Authentication
# API_KEY should be a comma-separated list of valid keys for multiple users/admin
API_KEY=your_api_key_here
REQUIRE_API_KEY=True

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# LLM Configuration
LLM_PROVIDER=openrouter or grok
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Storage Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=production_rag_v1

# Observability
SENTRY_DSN=your_sentry_dsn_here

# Deployment
RENDER_DEPLOY_HOOK=your_render_deploy_hook_here
